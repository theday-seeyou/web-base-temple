{
  "name": "theday-seeyou/web-base-temple",
  "type": "project",
  "license": "MIT",
  "homepage": "https://github.com/theday-seeyou/web-base-temple",
  "description": "Reusable ThinkPHP administration starter built on WebBase Core",
  "keywords": [
    "admin",
    "starter",
    "rbac",
    "thinkphp"
  ],
  "authors": [
    {
      "name": "WebBase contributors"
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "theday-seeyou/web-base-core": "^0.5",
    "topthink/framework": "^8.0",
    "topthink/think-migration": "^3.0",
    "topthink/think-orm": "^3.0",
    "topthink/think-view": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "app\\": "app"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@php think service:discover"
    ]
  },
  "config": {
    "allow-plugins": {},
    "platform": {
      "php": "8.1.0"
    },
    "sort-packages": true
  }
}
