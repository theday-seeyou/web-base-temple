{
  "name": "theday-seeyou/web-base-temple",
  "type": "project",
  "license": "MIT",
  "homepage": "https://github.com/theday-seeyou/web-base-temple",
  "description": "Bilingual enterprise CMS and website starter built on ThinkPHP",
  "keywords": [
    "cms",
    "enterprise-website",
    "multilingual",
    "thinkphp"
  ],
  "authors": [
    {
      "name": "WebBase contributors"
    }
  ],
  "repositories": [
    {
      "type": "path",
      "url": "packages/web-base-core",
      "options": {
        "symlink": false,
        "versions": {
          "theday-seeyou/web-base-core": "0.1.0"
        }
      }
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "theday-seeyou/web-base-core": "^0.1",
    "topthink/framework": "^8.0",
    "topthink/think-migration": "^3.0",
    "topthink/think-orm": "^3.0",
    "topthink/think-view": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "app\\": "app"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@php think service:discover"
    ]
  },
  "config": {
    "allow-plugins": {},
    "sort-packages": true
  }
}
